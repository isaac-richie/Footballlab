# Copy to .env if missing; never commit the populated .env.
# Optional TypeSafe JEV reviewer. Local statistics need no API key.
TYPESAFE_API_KEY=
# Optional live bookmaker odds from https://the-odds-api.com (free tier works).
ODDS_API_KEY=
# Optional formations, lineups and injuries from https://www.api-football.com (free plan: ~100 requests/day).
API_FOOTBALL_KEY=
# Optional community league sync (community/sync.py). Service key stays on this machine only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
