{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "includeFiles": "{*.py,index.html,data.json,badge_urls.json,community/web/{fx.js,motion.js,kits.js,logo-mark.svg},reports/{benchmark.json,experiments.json,accuracy_lab.json,prospective-grades.json,record.json,record-live.json}}"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!_vercel/).*)",
      "dest": "/api/index.py"
    }
  ]
}
